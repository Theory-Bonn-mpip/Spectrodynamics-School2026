<simulation verbosity='low'>
  <output prefix='mdp'>
    <trajectory filename='dipole' stride='1' extra_type='dipole'> extras </trajectory>
    <trajectory filename='polarizability' stride='1' extra_type='polarizability'> extras </trajectory>
    <trajectory filename='atomic_charges' stride='1' extra_type='atomic_charges'> extras </trajectory>
    <trajectory filename='atomic_dipoles' stride='1' extra_type='atomic_dipoles'> extras </trajectory>
    <trajectory filename='atomic_polarizabilities' stride='1' extra_type='atomic_polarizabilities'> extras </trajectory>
  </output>
  <total_steps> 2000 </total_steps>
  <prng>
    <seed> 31415 </seed>
  </prng>
  <ffsocket name='mace-mdp' mode='unix' matching='any'>
    <address> mdp-ex6 </address> <latency> 2e-4 </latency>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='ase'> template.xyz </file>
    </initialize>
    <forces>
      <force forcefield='mace-mdp'> </force>
    </forces>
    <motion mode='replay'>
      <file mode='ase'> ../trajectory_files/slab_lx10_ly10_lz100_n48_01/traj.xyz </file>
    </motion>
  </system>
</simulation>
