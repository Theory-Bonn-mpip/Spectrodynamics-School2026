# ---- simulation and analysis outputs (regenerated by the notebook) ----
# i-PI / client run outputs in the exercise folders
simulation.*
nvt2.*
mdp.*
ipi.log
mace_*.log
mdp_*.log
RESTART
EXIT
\#*\#
# analysis outputs of the exercise folders (references live in
# reference_results/ under different names and stay tracked)
Cvv.dat
Cvv_spectrum.dat
dipole_spce.dat
spce-dip*.dat
mdp-dip*.dat
mdp-iso*.dat
mdp-aniso*.dat
acf-*.dat

# ---- large data, not for git ----
# raw trajectories and extras provided to students via other channels
part_ii/trajectory_files/
part_iii/trajectory_files/*
!part_iii/trajectory_files/.gitkeep
!part_iii/trajectory_files/README.md

# MACE models: downloaded by ./download_models.sh, not kept in git
MODELS/*
!MODELS/README.md

# Part III analysis outputs
slab_profiles.dat
*ssVVCF_cf.dat
*ssVVCF_wcf.dat
*ssVVCF_ImChi2.dat
mdp_SFG_*.dat
first_pair_list.dat
!part_iii/excercise_*/reference_results/*
# cluster runs used to build the reference data
results_otter/

# ---- papers (copyrighted PDFs / extracted figures) ----
papers/

# ---- python / jupyter ----
__pycache__/
.ipynb_checkpoints/

# validation intermediates (regenerated by validation/run_validation.sh)
validation/traj.xyz
validation/dipole.dat
validation/polarizability.dat
validation/Cvv_*.dat
validation/fortran-*.dat
validation/python-*.dat
validation/FT_*.dat
validation/sfg/traj.xyz
validation/sfg/at*.dat
validation/sfg/f90_*.dat
validation/sfg/py_*.dat
validation/sfg/first_pair_list.dat

# i-PI input with the per-folder socket address, written by the run_ex*.sh
.input_run.xml

# editor swap/backup files (never deploy these)
.*.sw[op]
*~

# superseded reference data (kept locally, not distributed)
part_ii/excercise_2/reference_results/old/
part_ii/excercise_3/reference_results/old/
part_ii/excercise_4/reference_results/old/
