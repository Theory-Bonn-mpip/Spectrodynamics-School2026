<simulation verbosity='high'>
  <output prefix='nvt2'>
    <properties stride='1' filename='out'>  [ step, time{picosecond}, conserved, temperature{kelvin}, potential ] </properties>
    <trajectory filename='pos' stride='4' format="ase"> positions </trajectory>
    <checkpoint stride='500'/>
  </output>
  <total_time>10000000</total_time>
  <total_steps>2000</total_steps>
  <prng>
    <seed>31415</seed>
  </prng>
  <ffsocket name='mace' mode='unix' matching="any">
        <address>mace-ex2</address> <latency> 2e-4 </latency>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='ase'> init.xyz </file>
      <velocities mode='thermal' units='kelvin'> 300 </velocities>
    </initialize>
    <forces>
      <force forcefield='mace'> </force>
    </forces>
    <motion mode='dynamics'>
      <dynamics mode='nve'>
           <timestep units='femtosecond'> 0.5 </timestep>
       </dynamics>
  </motion>
    <ensemble>
      <temperature units='kelvin'> 300 </temperature>
    </ensemble>
  </system>
</simulation>
